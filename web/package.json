{
  "name": "yushi-mobile-web",
  "version": "0.1.0",
  "private": true,
  "description": "昱时 · iPhone 网页版（添加到主屏幕使用）",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "dev:local": "vite --host 127.0.0.1 --port 5180 --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.5.1",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "web-push": "3.6.7"
  }
}
